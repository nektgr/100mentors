// filepath: prisma/schema.prisma
datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id      Int     @id @default(autoincrement())
    name    String
    email   String  @unique
    posts   Post[]
}

model Post {
    id         Int      @id @default(autoincrement())
    content    String
    createdAt  DateTime @default(now())
    userId     Int
    author     User     @relation(fields: [userId], references: [id])
}